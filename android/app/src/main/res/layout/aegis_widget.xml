<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/aegis_widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tv_widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="⚪ AEGISMESH VPN • ВЫКЛ"
            android:textColor="#FF94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_widget_server"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Нажмите ВКЛ для запуска каскада"
            android:textColor="#FFF8FAFC"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/btn_widget_next"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/aegis_widget_btn_secondary"
        android:gravity="center"
        android:minWidth="46dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="⚡"
        android:textColor="#FF38BDF8"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btn_widget_toggle"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:background="@drawable/aegis_widget_btn_primary"
        android:gravity="center"
        android:minWidth="68dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="ВКЛ"
        android:textColor="#FF041311"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
